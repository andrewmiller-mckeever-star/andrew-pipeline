# Andrew's Usage Signals — local development env
# Copy to .env and fill in values, then: python3 signals_run.py --dry-run

# Salesforce credentials
# Get security token: Salesforce → Settings → Reset My Security Token
SF_USERNAME=andrew.miller-mckeever@you.com
SF_PASSWORD=your_sf_password
SF_SECURITY_TOKEN=your_sf_security_token

# Slack bot token (xoxb-...) — needs chat:write scope
# Get from: api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# You.com API key — optional, enables LinkedIn profile links in alerts
# Skip this and LinkedIn lookups are just disabled gracefully
YDC_API_KEY=your_ydc_api_key

# GCS bucket for burst/ramp cooldown state — set automatically in Cloud Run
# For local testing, state is saved to .burst_state.json / .ramp_state.json instead
# BURST_STATE_BUCKET=andrew-sales-toolkit-signals-state
